<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登入 - 我的網誌</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">
  <div class="auth-container">
    <div class="auth-card">
      <h1 class="auth-logo">我的網誌</h1>
      <p class="auth-sub">登入你的帳號</p>
      <form action="/login" method="POST" class="auth-form">
        <input type="text" name="username" placeholder="使用者名稱" required autofocus>
        <input type="password" name="password" placeholder="密碼" required>
        <button type="submit" class="auth-btn">登入</button>
      </form>
      <p class="auth-link">還沒有帳號？<a href="/register">立即註冊</a></p>
      <a href="/" class="auth-back">← 回首頁</a>
    </div>
  </div>
</body>
</html>

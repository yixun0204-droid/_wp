<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> - 我的網誌</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <div class="nav-left">
        <h1 class="logo"><a href="/">我的網誌</a></h1>
        <a href="/reels" class="nav-link">Shorts</a>
      </div>
      <div class="nav-right">
        <% if (user) { %>
          <div class="nav-user">
            <% if (user.avatar_url) { %>
              <img src="<%= user.avatar_url %>" class="avatar-sm avatar-img">
            <% } else { %>
              <div class="avatar-sm" style="background:<%= user.avatar_color %>"><%= user.username[0] %></div>
            <% } %>
            <span class="nav-username"><%= user.username %></span>
            <a href="/profile" class="nav-link">編輯檔案</a>
            <a href="/new" class="new-post-btn">寫文章</a>
            <form action="/logout" method="POST" style="display:inline">
              <button type="submit" class="nav-logout">登出</button>
            </form>
          </div>
        <% } else { %>
          <a href="/login" class="new-post-btn">登入</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="feed">
    <article class="fb-post">
      <div class="post-header">
        <% if (post.avatar_url) { %>
          <img src="<%= post.avatar_url %>" class="avatar avatar-img">
        <% } else { %>
          <div class="avatar" style="background:<%= post.avatar_color || '#0866ff' %>">
            <%= post.username ? post.username[0] : post.title[0] %>
          </div>
        <% } %>
        <div class="post-author">
          <span class="author-name"><%= post.username || post.title %></span>
          <span class="post-time"><%= new Date(post.created_at).toLocaleString('zh-TW') %></span>
          <% if (post.updated_at !== post.created_at) { %>
            <span class="post-time">（已編輯 <%= new Date(post.updated_at).toLocaleString('zh-TW') %>）</span>
          <% } %>
        </div>
      </div>
      <div class="post-body"><p><%- post.content.replace(/\n/g, '<br>') %></p></div>
      <div class="post-actions">
        <span class="action-btn">💬 <%= post.comment_count %> 留言</span>
        <div class="post-action-links">
          <a href="/" class="action-link">回列表</a>
          <% if (user && post.user_id == user.id) { %>
            <a href="/edit/<%= post.id %>" class="action-link">編輯</a>
            <form action="/delete/<%= post.id %>" method="POST" style="display:inline">
              <button type="submit" class="action-link delete" onclick="return confirm('確定刪除？')">刪除</button>
            </form>
          <% } %>
        </div>
      </div>

      <div class="comments-section">
        <% if (comments.length > 0) { %>
          <div class="comments-divider"></div>
          <% comments.forEach(c => { %>
            <div class="comment">
              <% if (c.avatar_url) { %>
                <img src="<%= c.avatar_url %>" class="comment-avatar avatar-img">
              <% } else { %>
                <div class="comment-avatar" style="background:<%= c.avatar_color || '#e4e6eb' %>">
                  <%= c.username ? c.username[0] : c.author[0] %>
                </div>
              <% } %>
              <div class="comment-bubble">
                <span class="comment-author"><%= c.username || c.author %></span>
                <span class="comment-text"><%= c.content %></span>
                <span class="comment-time"><%= new Date(c.created_at).toLocaleString('zh-TW') %></span>
              </div>
            </div>
          <% }); %>
        <% } %>

        <form action="/comment/<%= post.id %>" method="POST" class="comment-form">
          <% if (user && user.avatar_url) { %>
            <img src="<%= user.avatar_url %>" class="comment-form-avatar avatar-img">
          <% } else { %>
            <div class="comment-form-avatar" style="background:<%= user ? user.avatar_color : '#0866ff' %>">
              <%= user ? user.username[0] : '我' %>
            </div>
          <% } %>
          <div class="comment-form-fields">
            <% if (!user) { %><input type="text" name="author" placeholder="姓名" required><% } %>
            <input type="text" name="content" placeholder="寫下留言..." required>
            <button type="submit">送出</button>
          </div>
        </form>
      </div>
    </article>
  </div>
</body>
</html>

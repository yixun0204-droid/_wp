<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Shorts - 我的網誌</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="shorts-page">
  <nav class="shorts-nav">
    <div class="shorts-nav-inner">
      <a href="/" class="shorts-back">← 首頁</a>
      <h1 class="shorts-logo">Shorts</h1>
      <a href="/upload" class="shorts-upload-btn">＋</a>
    </div>
  </nav>

  <% if (videos.length === 0) { %>
    <div class="shorts-empty">
      <p>尚無 Shorts</p>
      <a href="/upload">上傳第一支短片</a>
    </div>
  <% } else { %>
    <div class="shorts-feed">
      <% videos.forEach((v, i) => { %>
        <div class="short-card" id="short-<%= v.id %>">
          <div class="short-video-wrap">
            <iframe src="<%= v.url.includes('embed') ? v.url : v.url.replace('watch?v=', 'embed/') %>?autoplay=<%= i === 0 ? 1 : 0 %>&controls=1&rel=0&loop=1"
              frameborder="0" allow="autoplay; encrypted-media" allowfullscreen class="short-video"></iframe>
          </div>

          <div class="short-overlay">
            <div class="short-info">
              <div class="short-user">
                <% if (v.avatar_url) { %>
                  <img src="<%= v.avatar_url %>" class="avatar-sm avatar-img">
                <% } else { %>
                  <div class="avatar-sm" style="background:<%= v.avatar_color || '#0866ff' %>"><%= v.username ? v.username[0] : '?' %></div>
                <% } %>
                <span class="short-username"><%= v.username || '未知' %></span>
              </div>
              <h3 class="short-title"><%= v.title %></h3>
              <% if (v.description) { %><p class="short-desc"><%= v.description %></p><% } %>
            </div>

            <div class="short-actions">
              <button class="short-action-btn" onclick="this.classList.toggle('liked')">👍 <span class="short-action-label">讚</span></button>
              <button class="short-action-btn">👎 <span class="short-action-label">倒讚</span></button>
              <a href="/post" class="short-action-btn">💬 <span class="short-action-label">留言</span></a>
              <button class="short-action-btn" onclick="navigator.clipboard?.writeText(window.location.href)">🔗 <span class="short-action-label">分享</span></button>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</body>
</html>

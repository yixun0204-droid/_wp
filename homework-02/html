<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTML Input Type 萬花筒全功能表單</title>
    <style>
        body {
            font-family: "Segoe UI", Microsoft JhengHei, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .form-container {
            background-color: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            max-width: 700px;
            width: 100%;
        }
        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 30px;
        }
        fieldset {
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 20px;
            margin-bottom: 25px;
            background-color: #fafafa;
        }
        legend {
            font-weight: bold;
            color: #2980b9;
            padding: 0 10px;
        }
        .form-group {
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
        }
        .form-group.row {
            flex-direction: row;
            align-items: center;
            gap: 10px;
        }
        label {
            margin-bottom: 5px;
            font-weight: 600;
            font-size: 0.95em;
        }
        /* 統一文字類輸入框樣式 */
        input[type="text"],
        input[type="password"],
        input[type="email"],
        input[type="url"],
        input[type="tel"],
        input[type="number"],
        input[type="search"],
        input[type="date"],
        input[type="time"],
        input[type="datetime-local"],
        input[type="month"],
        input[type="week"] {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 1em;
            width: 100%;
            box-sizing: border-box;
            transition: border-color 0.3s;
        }
        input:focus {
            border-color: #3498db;
            outline: none;
            box-shadow: 0 0 5px rgba(52, 152, 219, 0.3);
        }
        /* 特殊 input 調整 */
        input[type="color"] {
            border: none;
            width: 50px;
            height: 40px;
            cursor: pointer;
        }
        input[type="range"] {
            width: 100%;
            cursor: pointer;
        }
        .checkbox-group, .radio-group {
            display: flex;
            gap: 15px;
            margin-top: 5px;
        }
        .checkbox-group label, .radio-group label {
            font-weight: normal;
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
        }
        /* 按鈕樣式 */
        .btn-container {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        input[type="submit"],
        input[type="button"],
        input[type="reset"],
        button {
            flex: 1;
            padding: 12px;
            font-size: 1em;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        input[type="submit"] { background-color: #2ecc71; color: white; }
        input[type="submit"]:hover { background-color: #27ae60; }
        
        input[type="reset"] { background-color: #e74c3c; color: white; }
        input[type="reset"]:hover { background-color: #c0392b; }

        input[type="button"] { background-color: #3498db; color: white; }
        input[type="button"]:hover { background-color: #2980b9; }
    </style>
</head>
<body>

<div class="form-container">
    <h1>HTML5 全功能表單展示</h1>
    <form action="#" method="post" enctype="multipart/form-data" onsubmit="alert('表單已模擬送出！'); return false;">
        
        <!-- 1. 基礎文字輸入群組 -->
        <fieldset>
            <legend>基本文字與身份輸入</legend>
            
            <div class="form-group">
                <label for="username">文字輸入 (type="text")：</label>
                <input type="text" id="username" name="username" placeholder="請輸入姓名或帳號" required>
            </div>
            
            <div class="form-group">
                <label for="pwd">密碼輸入 (type="password")：</label>
                <input type="password" id="pwd" name="pwd" placeholder="請輸入密碼">
            </div>

            <div class="form-group">
                <label for="usersearch">搜尋框 (type="search")：</label>
                <input type="search" id="usersearch" name="usersearch" placeholder="輸入關鍵字...">
            </div>
            
            <!-- 隱藏欄位，使用者看不到，常用於帶入特定 ID -->
            <input type="hidden" name="userID" value="9527">
        </fieldset>

        <!-- 2. 嚴格格式驗證群組 -->
        <fieldset>
            <legend>嚴格格式驗證欄位 (行動裝置會自動切換鍵盤)</legend>
            
            <div class="form-group">
                <label for="useremail">電子郵件 (type="email")：</label>
                <input type="email" id="useremail" name="useremail" placeholder="example@email.com">
            </div>
            
            <div class="form-group">
                <label for="userurl">網址連結 (type="url")：</label>
                <input type="url" id="userurl" name="userurl" placeholder="https://example.com">
            </div>
            
            <div class="form-group">
                <label for="usertel">電話號碼 (type="tel")：</label>
                <input type="tel" id="usertel" name="usertel" placeholder="0912-345678">
            </div>
        </fieldset>

        <!-- 3. 數字與選擇群組 -->
        <fieldset>
            <legend>數字、範圍與多選/單選</legend>
            
            <div class="form-group">
                <label for="age">數字限制 (type="number" 限制 18-99 歲)：</label>
                <input type="number" id="age" name="age" min="18" max="99" value="25">
            </div>
            
            <div class="form-group">
                <label for="satisfaction">滑桿範圍 (type="range" 0-100)：</label>
                <input type="range" id="satisfaction" name="satisfaction" min="0" max="100" value="80" oninput="this.nextElementSibling.value = this.value">
                <output style="text-align: center; font-weight: bold; margin-top: 5px;">80</output>
            </div>

            <div class="form-group">
                <label>複選框 (type="checkbox")：</label>
                <div class="checkbox-group">
                    <label><input type="checkbox" name="hobby" value="code" checked> 寫程式</label>
                    <label><input type="checkbox" name="hobby" value="music"> 聽音樂</label>
                    <label><input type="checkbox" name="hobby" value="game"> 打電動</label>
                </div>
            </div>

            <div class="form-group">
                <label>單選鈕 (type="radio")：</label>
                <div class="radio-group">
                    <label><input type="radio" name="gender" value="male"> 男</label>
                    <label><input type="radio" name="gender" value="female" checked> 女</label>
                    <label><input type="radio" name="gender" value="other"> 其他</label>
                </div>
            </div>
        </fieldset>

        <!-- 4. 日期與時間群組 -->
        <fieldset>
            <legend>日期與時間選擇器</legend>
            
            <div class="form-group">
                <label for="userdate">完整日期 (type="date")：</label>
                <input type="date" id="userdate" name="userdate">
            </div>
            
            <div class="form-group">
                <label for="usertime">時間 (type="time")：</label>
                <input type="time" id="usertime" name="usertime">
            </div>
            
            <div class="form-group">
                <label for="userdatetime">日期與時間 (type="datetime-local")：</label>
                <input type="datetime-local" id="userdatetime" name="userdatetime">
            </div>

            <div class="form-group">
                <label for="usermonth">月份選擇 (type="month")：</label>
                <input type="month" id="usermonth" name="usermonth">
            </div>

            <div class="form-group">
                <label for="userweek">週別選擇 (type="week")：</label>
                <input type="week" id="userweek" name="userweek">
            </div>
        </fieldset>

        <!-- 5. 多媒體與特殊群組 -->
        <fieldset>
            <legend>多媒體、色彩與資料清單</legend>
            
            <div class="form-group">
                <label for="userfile">檔案上傳 (type="file")：</label>
                <input type="file" id="userfile" name="userfile">
            </div>
            
            <div class="form-group row">
                <label for="favcolor">色彩選擇器 (type="color")：</label>
                <input type="color" id="favcolor" name="favcolor" value="#3498db">
            </div>

            <div class="form-group">
                <label for="browser">關鍵字建議選單 (Text + datalist 結合)：</label>
                <input type="text" id="browser" name="browser" list="browsers" placeholder="請輸入或選擇瀏覽器">
                <datalist id="browsers">
                    <option value="Google Chrome">
                    <option value="Mozilla Firefox">
                    <option value="Microsoft Edge">
                    <option value="Safari">
                    <option value="Opera">
                </datalist>
            </div>
        </fieldset>

        <!-- 6. 按鈕群組 -->
        <fieldset>
            <legend>按鈕樣式控制</legend>
            <div class="btn-container">
                <!-- 送出表單按鈕 -->
                <input type="submit" value="送出表單 (Submit)">
                
                <!-- 重設表單按鈕 -->
                <input type="reset" value="重設 (Reset)">
                
                <!-- 一般功能性按鈕 -->
                <input type="button" value="一般按鈕 (Button)" onclick="alert('你點擊了一般按鈕！')">
            </div>
            
            <div class="form-group" style="margin-top: 15px; align-items: center;">
                <label>圖片形式的送出鈕 (type="image")：</label>
                <!-- 這裡用 placeholder 圖片替代，點擊它等同於 Submit -->
                <input type="image" src="https://via.placeholder.com/120x40/34495e/ffffff?text=Image+Submit" alt="Submit">
            </div>
        </fieldset>

    </form>
</div>

</body>
</html>

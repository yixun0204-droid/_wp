const jsonString = '{"id": 101, "name": "王小五", "level": "Normal"}';

function upgradeUser(jsonInput) {
    let userObj = JSON.parse(jsonInput);
    userObj.level = "VIP";
    userObj.upgradedAt = "2026/05/17"; 
    
    return JSON.stringify(userObj);
}

// 執行測試
console.log(upgradeUser(jsonString));
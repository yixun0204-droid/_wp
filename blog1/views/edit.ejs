<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>編輯文章 - 我的網誌</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <div class="nav-left">
        <h1 class="logo"><a href="/">我的網誌</a></h1>
        <a href="/reels" class="nav-link">🎬 短片</a>
      </div>
      <div class="nav-right">
        <% if (user) { %>
          <div class="nav-user">
            <div class="avatar-sm" style="background:<%= user.avatar_color %>"><%= user.username[0] %></div>
            <span class="nav-username"><%= user.username %></span>
            <form action="/logout" method="POST" style="display:inline">
              <button type="submit" class="nav-logout">登出</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="feed">
    <div class="fb-post">
      <h2 class="form-title">編輯文章</h2>
      <form action="/update/<%= post.id %>" method="POST" class="post-form">
        <input type="text" name="title" value="<%= post.title %>" required autofocus>
        <textarea name="content" rows="8" required><%= post.content %></textarea>
        <div class="form-btns">
          <button type="submit" class="fb-btn">更新</button>
          <a href="/" class="fb-btn fb-btn-cancel">取消</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>

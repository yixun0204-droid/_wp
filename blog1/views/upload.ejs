<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>上傳短片 - 我的網誌</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-inner">
      <h1 class="logo"><a href="/">我的網誌</a></h1>
    </div>
  </nav>

  <div class="feed">
    <div class="fb-post">
      <h2 class="form-title">上傳短片</h2>
      <p style="color:#65676b;margin-bottom:16px;">貼上 YouTube 影片網址即可分享</p>
      <form action="/upload" method="POST" class="post-form">
        <input type="text" name="title" placeholder="影片標題" required autofocus>
        <input type="url" name="url" placeholder="YouTube 網址（如 https://youtube.com/watch?v=xxxx）" required>
        <textarea name="description" rows="3" placeholder="描述（選填）"></textarea>
        <div class="form-btns">
          <button type="submit" class="fb-btn">發布</button>
          <a href="/reels" class="fb-btn fb-btn-cancel">取消</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>

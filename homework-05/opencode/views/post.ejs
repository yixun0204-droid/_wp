<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= post.title %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 720px; margin: 0 auto; padding: 2rem; line-height: 1.6; color: #333; }
    h1 { margin-bottom: 0.5rem; }
    .meta { color: #888; font-size: 0.85rem; margin-bottom: 1.5rem; }
    .content { white-space: pre-wrap; margin-bottom: 2rem; }
    .actions { display: flex; gap: 0.75rem; }
    .actions a, .actions button { padding: 0.4rem 1rem; border-radius: 6px; cursor: pointer; font-size: 0.9rem; }
    .btn-edit { background: #2563eb; color: #fff; border: none; text-decoration: none; display: inline-block; }
    .btn-delete { background: #dc2626; color: #fff; border: none; }
    .back { display: inline-block; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <a href="/" class="back">&larr; Back</a>
  <h1><%= post.title %></h1>
  <div class="meta"><%= post.created_at %></div>
  <div class="content"><%= post.content %></div>
  <div class="actions">
    <a href="/post/<%= post.id %>/edit" class="btn-edit">Edit</a>
    <form action="/post/<%= post.id %>/delete" method="POST" style="display:inline">
      <button type="submit" class="btn-delete" onclick="return confirm('Delete this post?')">Delete</button>
    </form>
  </div>
</body>
</html>
